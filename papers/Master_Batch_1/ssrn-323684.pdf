									<h3 tabindex="0"><span class="title optClickTitle no-underline">Determinants of Revenue Reporting Practices for Internet Firms</span></h3>
								
							
							
							<div class="note note-list">
								
								
									<span tabindex="0">Posted: 14 Oct 2002</span>
								
								
							</div>
							
							<div class="current">
								<i class="icon-gizmo-eye"></i>
